{
  "name": "mitosisin",
  "version": "1.0.0",
  "description": "Your Figma Plugin",
  "main": "code.js",
  "workspaces": [
    "web",
    "bridge"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "tsc -p tsconfig.json",
    "web:dev": "npm --workspace @mitosis/web run dev",
    "web:build": "npm --workspace @mitosis/web run build",
    "bridge:dev": "npm --workspace @mitosis/bridge run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "watch": "npm run build -- --watch",
    "dev": "npm run build -- --watch & node launcher-server.js",
    "dev:all": "npm run build -- --watch & npm --workspace @mitosis/web run dev & npm --workspace @mitosis/bridge run dev",
    "launcher:start": "node launcher.js start",
    "launcher:stop": "node launcher.js stop"
  },
  "author": "",
  "license": "",
  "devDependencies": {},
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.10",
    "@eslint/js": "^9.39.4",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
